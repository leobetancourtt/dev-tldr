# dev-tldr endpoints - read by install.sh and install.ps1.
#
# Defaults below are the public vendor URLs. If your company provides its own
# (gateway, proxy, GitHub Enterprise, internal registry, internal Slack app),
# change them here, or put overrides in endpoints.local.env (git-ignored).
#
# Precedence (highest first): real environment variables > endpoints.local.env > this file.
# Format: KEY=value, one per line. No quotes needed, no spaces around "=".
# Leave a value empty to use the default behaviour.

# --- Atlassian (Jira + Confluence) -------------------------------------------
# Remote MCP server for browser login (OAuth).
ATLASSIAN_MCP_URL_OAUTH=https://mcp.atlassian.com/v1/mcp/authv2
# Remote MCP server for API-token auth (Basic with email:token). Admin must enable it.
ATLASSIAN_MCP_URL_TOKEN=https://mcp.atlassian.com/v2/mcp

# --- Slack -------------------------------------------------------------------
# Official hosted Slack MCP server (OAuth only; admin-approved app required).
SLACK_MCP_URL=https://mcp.slack.com/mcp
# Optional: client ID of your company's internal Slack app. When set, the installer
# registers Slack with this OAuth client instead of the default one.
SLACK_OAUTH_CLIENT_ID=
SLACK_OAUTH_CALLBACK_PORT=3118

# --- GitHub ------------------------------------------------------------------
# Remote MCP server (Claude Code, token auth).
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp
# REST API base, used only to validate the token.
# GitHub Enterprise Server: https://YOUR-HOST/api/v3
GITHUB_API_URL=https://api.github.com
# Local MCP server image for Claude Desktop (needs Docker). Point at an internal
# registry mirror if ghcr.io is blocked.
GITHUB_MCP_DOCKER_IMAGE=ghcr.io/github/github-mcp-server
# Optional, GitHub Enterprise only: host passed to the local server (e.g. https://github.yourco.com).
GITHUB_HOST=
